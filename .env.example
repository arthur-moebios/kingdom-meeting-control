# Copy to .env and adjust. Never commit the real .env.
# ---- Server ----
KMC_HOST=127.0.0.1
KMC_PORT=4317
# Comma-separated roles tokens. Keep these secret. Rotate if leaked.
# Admin can control the meeting/share; viewer can only read state.
KMC_ADMIN_TOKEN=change-me-admin
KMC_VIEWER_TOKEN=change-me-viewer

# ---- Paths (default to ./runtime next to the repo) ----
KMC_DATA_DIR=./runtime/data
KMC_CHROMIUM_PROFILE_DIR=./runtime/chromium-profile
KMC_LOG_LEVEL=info

# ---- Zoom ----
# The persistent browser opens this first. Override only if needed.
KMC_ZOOM_WEB_URL=https://app.zoom.us/wc/home
# Run Chromium visibly (required for assisted login). Set to true to hide.
KMC_CHROMIUM_HEADLESS=false
