{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@kmc/shared-types": ["../../packages/shared-types/src/index.ts"]
    },
    "baseUrl": "."
  },
  "//include": "vite.config.ts is type-checked by Vite itself; excluded here to avoid a duplicate-vite type clash in the monorepo.",
  "include": ["src"]
}
